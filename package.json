{
  "name": "angular-playwright-testing",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Angular & MEAN Ticket Tracker with Hermetic Multi-Worker Playwright Testing",
  "type": "module",
  "scripts": {
    "start": "npm start --prefix server",
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev --prefix server\" \"npm start --prefix client\"",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "test": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:server && npm run test:client",
    "test:server": "npm test --prefix server",
    "test:client": "npm run test --prefix client -- --watch=false",
    "test:e2e": "playwright test",
    "test:worker1": "playwright test --project=worker-1",
    "test:worker2": "playwright test --project=worker-2",
    "test:worker3": "playwright test --project=worker-3",
    "test:worker4": "playwright test --project=worker-4",
    "test:worker5": "playwright test --project=worker-5",
    "test:journey": "playwright test --project=worker-5 e2e",
    "test:login": "playwright test --project=worker-1 --project=worker-2",
    "test:tickets": "playwright test --project=worker-3 --project=worker-4",
    "test:smoke": "playwright test --grep @smoke",
    "test:functional": "playwright test login/functional tickets/functional",
    "test:ui-browser": "playwright test login/ui-browser tickets/ui-browser",
    "test:a11y": "playwright test --grep @a11y",
    "test:performance": "playwright test --grep @performance",
    "test:resilience": "playwright test --grep @resilience",
    "test:specialized": "playwright test --grep @specialized",
    "test:mutation": "playwright test --grep @mutation",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix server && npm run build --prefix client"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.3"
  }
}

